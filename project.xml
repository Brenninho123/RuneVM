<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="RuneVM" package="com.rune.vm" version="1.0.0" company="Brenninho123" />
	
	<app main="Main" path="export" file="RuneVM" />
	
	<source path="source" />
	
	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="hxcpp" />
	<haxelib name="flixel" />
	<haxelib name="extension-androidtools" if="android" />

	<icon path="assets/icon.png" />

	<config android="true" install-location="auto" target-sdk-version="33" min-sdk-version="21" if="android" />
	<template path="template/application/AndroidManifest.xml" rename="AndroidManifest.xml" if="android" />

	<android permission="android.permission.READ_EXTERNAL_STORAGE" if="android" />
	<android permission="android.permission.WRITE_EXTERNAL_STORAGE" if="android" />
	<android permission="android.permission.MANAGE_EXTERNAL_STORAGE" if="android" />

	<haxedef name="HXCPP_ANDROID_PLATFORM" value="21" if="android" />
	<haxedef name="HXCPP_CPP11" if="android" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="android" />
	<haxeflag name="-dce" value="full" />
	<haxedef name="HXCPP_CHECK_POINTER" if="debug" />
	<haxedef name="HXCPP_STACK_LINE" if="debug" />

	<window fps="60" hardware="true" vsync="true" />
	<window width="1280" height="720" resizable="true" unless="mobile" />

	<assets path="assets" rename="assets" />
</project>
