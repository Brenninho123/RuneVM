import lime.tools.HXProject;
import lime.tools.MetaData;
import lime.tools.Application;
import lime.tools.Window;

class Project extends HXProject {
	public function new() {
		super();

		meta = {
			title: "RuneVM",
			packageName: "com.rune.vm",
			version: "1.0.0",
			company: "Brenninho123"
		};

		app = {
			main: "Main",
			path: "export",
			file: "RuneVM"
		};

		sources.push("source");

		haxelibs.push({name: "lime"});
		haxelibs.push({name: "openfl"});
		haxelibs.push({name: "hxcpp"});
		haxelibs.push({name: "flixel"});

		if (buildingFor("android")) {
			haxelibs.push({name: "extension-androidtools"});

			config.android.installLocation = "auto";
			config.android.targetSdkVersion = 33;
			config.android.minSdkVersion = 21;

			templatePaths.push("template/application/AndroidManifest.xml");

			permissions.push("android.permission.READ_EXTERNAL_STORAGE");
			permissions.push("android.permission.WRITE_EXTERNAL_STORAGE");
			permissions.push("android.permission.MANAGE_EXTERNAL_STORAGE");
		}

		icons.push({path: "assets/icon.png"});

		haxeflags.push("-dce full");

		if (debug) {
			haxedefs.set("HXCPP_CHECK_POINTER", "1");
			haxedefs.set("HXCPP_STACK_LINE", "1");
		}

		var window:Window = {
			fps: 60,
			hardware: true,
			vsync: true,
			width: 1280,
			height: 720,
			resizable: true
		};

		if (buildingFor("mobile")) {
			window.width = 0;
			window.height = 0;
			window.resizable = false;
		}

		windows.push(window);

		includeAssets("assets", "assets");
	}

	private function buildingFor(target:String):Bool {
		return hasDef(target) || (targetFlags != null && targetFlags.exists(target));
	}
}
